# Copy to deploy/.env.ec2 on the EC2 host; replace the placeholders.
# Images built for x86_64 (linux/amd64); v2 contains source commit 79979f366e80.
NIMBUS_BACKEND_IMAGE=khoadev303/nimbus-backend:v2
NIMBUS_FACE_IMAGE=khoadev303/nimbus-face-api:v2
FIREBASE_ADMIN_KEY_PATH=/srv/nimbus/secrets/firebase-admin.json
FACE_MODEL_PATH=/srv/nimbus/private-face-model
