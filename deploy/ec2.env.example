# Copy to deploy/.env.ec2 on the EC2 host; replace the placeholders.
# Use immutable version tags built for the EC2 CPU architecture.
NIMBUS_BACKEND_IMAGE=dockerhub-user/nimbus-backend:release-tag
NIMBUS_FACE_IMAGE=dockerhub-user/nimbus-face-api:release-tag
FIREBASE_ADMIN_KEY_PATH=/srv/nimbus/secrets/firebase-admin.json
FACE_MODEL_PATH=/srv/nimbus/private-face-model
